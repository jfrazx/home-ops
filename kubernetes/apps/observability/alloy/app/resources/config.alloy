// Alloy Configuration — Kubernetes events only.
//
// Container logs are NOT collected here. They are collected by Vector, which is
// deployed as a DaemonSet by the victoria-logs HelmRelease and writes straight
// into VictoriaLogs. Alloy is kept for one job Vector has no source for:
// Kubernetes events. Do not re-add a pod-log pipeline here without removing
// Vector's, or every container line is stored twice.
//
// Both writers land in the same VictoriaLogs instance.

logging {
  level    = "warn"
  format   = "json"
  write_to = [loki.write.default.receiver]
}

/********************************************
 * LOG COLLECTION - KUBERNETES EVENTS
 ********************************************/

// Kubernetes only retains events for ~1h in etcd. Shipping them here is what
// makes them available after the fact, which is precisely when a post mortem
// needs them.
loki.source.kubernetes_events "cluster_events" {
  job_name   = "integrations/kubernetes/eventhandler"
  log_format = "logfmt"
  forward_to = [loki.process.cluster_events.receiver]
}

loki.process "cluster_events" {
  forward_to = [loki.write.default.receiver]

  stage.static_labels {
    values = {
      cluster = "main",
      source  = "kubernetes-events",
    }
  }
}

/********************************************
 * OUTPUT - VICTORIALOGS (Loki push API)
 ********************************************/

// VictoriaLogs implements the Loki push API, so Alloy needs no special sink --
// only the endpoint path. It accepts Alloy's snappy/protobuf encoding as well
// as JSON.
//
// `_stream_fields` selects which labels become VictoriaLogs *stream* fields.
// Everything else is still stored and searchable, just not part of the stream
// identity, so keep this list low-cardinality.
loki.write "default" {
  endpoint {
    url = "http://victoria-logs-server.observability.svc.cluster.local:9428/insert/loki/api/v1/push?_stream_fields=cluster,source,job"

    // Optimize batching for better performance
    max_backoff_period  = "5m"
    min_backoff_period  = "500ms"
    max_backoff_retries = 10
  }
}
